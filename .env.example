APP_NAME=Tradecraft
APP_ENV=local
APP_DEBUG=true
APP_URL=http://Tradecraft.test

# DB (Laragon default root user without password; change as needed)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=Tradecraft_db
DB_USER=root
DB_PASS=

# MAIL (dev mode writes 'emails' to storage/mail/*.log)
MAIL_FROM_NAME=Tradecraft
MAIL_FROM_ADDRESS=no-reply@Tradecraft.test

# SECURITY
SESSION_NAME=Tradecraft_session
CSRF_KEY=change-this-32-bytes-secret
